# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/varsaweb?schema=public"

# NextAuth.js
AUTH_SECRET="your-auth-secret-here"
# Generate with: npx auth secret
AUTH_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Configuration (for admin notifications)
# For Gmail: use smtp.gmail.com, port 587, and an App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="VarsaWeb <noreply@varsaweb.com>"
